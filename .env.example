DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-development-key
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
LOCAL_API_KEY=replace-with-a-long-random-local-key
LOCAL_PORT=8765

STATION_ID=AUTOSERVICE-DEV-001
STATION_COUNTRY_CODE=DO
STATION_TIMEZONE=America/Santo_Domingo

CASH_ACCEPTOR_DRIVER=simulator
CASH_CURRENCY=USD
CASH_EXPECTED_DATASET_CURRENCY=USD
CASH_ACCEPT_ALL_DATASET_DENOMINATIONS=true
CASH_ACCEPTED_DENOMINATIONS_MINOR=100,200,500,1000,2000,5000,10000
CASH_SIMULATOR_DATASET_CURRENCY=USD
CASH_SIMULATOR_DATASET_VERSION=USD-SIM-001
CASH_SIMULATOR_FIRMWARE_VERSION=NV200-SIM-001

# Driver real (habilitar con CASH_ACCEPTOR_DRIVER=nv200_essp).
# Confirma el número de puerto en Administrador de dispositivos de Windows.
NV200_COM_PORT=COM3
NV200_BAUD_RATE=9600
NV200_SSP_ADDRESS=0
NV200_COMMAND_TIMEOUT_SECONDS=1.0
NV200_WRITE_TIMEOUT_SECONDS=0.5
NV200_COMMAND_ATTEMPTS=3
NV200_MIN_PROTOCOL_VERSION=6
NV200_MAX_PROTOCOL_VERSION=20
NV200_FIXED_KEY=0x0123456701234567
NV200_POLL_WITH_ACK=true
NV200_POLL_INTERVAL_SECONDS=0.2

# Lector RFID. Usa crt603_serial en la estación real.
CARD_READER_DRIVER=simulator
CARD_CREDENTIAL_APPLICATION_ID=D3E001
CARD_ALLOW_TEST_PROVISIONING=false
CARD_PROVISIONING_MASTER_KEY_HEX=
CRT603_COM_PORT=COM4
CRT603_BAUD_RATE=19200
CRT603_COMMAND_TIMEOUT_SECONDS=1.0
CRT603_WRITE_TIMEOUT_SECONDS=0.5
CRT603_COMMAND_ATTEMPTS=2

# Monitor exclusivamente de la puerta frontal mediante XL128 V1.2.
# Solo lectura; nunca acciona la cerradura. Mapeo confirmado físicamente:
# 00 = frontal cerrada, 01 = frontal abierta.
DOOR_MONITOR_DRIVER=simulator
DOOR_SIMULATOR_STATE=closed
XL128_COM_PORT=COM1
XL128_BAUD_RATE=9600
XL128_COMMAND_TIMEOUT_SECONDS=1.0
XL128_WRITE_TIMEOUT_SECONDS=0.5
XL128_COMMAND_ATTEMPTS=2
XL128_DOOR_OPEN_RESPONSE_CODES=01
XL128_DOOR_CLOSED_RESPONSE_CODES=00
DOOR_MONITOR_BACKGROUND_ENABLED=true
DOOR_MONITOR_POLL_INTERVAL_SECONDS=0.5
DOOR_MONITOR_DEBOUNCE_SAMPLES=2
DOOR_MONITOR_OFFLINE_AFTER_FAILURES=3
DOOR_MONITOR_RECOVERY_SAMPLES=2

# Monitor de estado USB de la impresora CUSTOM K80. No imprime, alimenta ni corta papel.
# La estación probada usa Python x64 y la CePrnLib.dll x64 incluida en vendor/.
PRINTER_MONITOR_DRIVER=simulator
PRINTER_SIMULATOR_RAW_STATUS=0x00000000
PRINTER_SIMULATOR_PAPER_REMAINING_CM=
CUSTOM_K80_PRINTER_NAME=CUSTOM K80
# Vacío no es necesario: por defecto usa vendor/custom_k80/x64/CePrnLib.dll.
CUSTOM_K80_CEPRNLIB_DLL_PATH=
# Vacío usa %WINDIR%\System32\CeSMLm.dll.
CUSTOM_K80_CESMLM_DLL_PATH=
CUSTOM_K80_QUERY_REMAINING_PAPER=true
# Mantener en false hasta validar físicamente las máscaras con esta K80.
CUSTOM_K80_STATUS_MAPPING_VALIDATED=false

# Especificar solamente los orígenes autorizados, separados por coma.
# Ejemplo: https://autoservice.example.com
CORS_ALLOWED_ORIGINS=
